# Copy to .env and fill in real values. Never commit real secrets.

# Database — SQLite path is relative to prisma/. For Postgres/Supabase see README.
DATABASE_URL="file:./dev.db"

# HMAC secret for demo session tokens (any long random string)
AUTH_SECRET="generate-a-random-string"

# AI provider (optional). Without a key, agents use the deterministic rules engine
# and every output is labelled "Rules engine".
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
BC_LLM_EFFORT="medium"
BC_PRICE_IN_PER_MTOK="2"
BC_PRICE_OUT_PER_MTOK="10"

# Local open-weight models via Ollama (https://ollama.com). Set LLM_PROVIDER="ollama" to use them.
# LLM_PROVIDER: "anthropic" | "ollama" | "openai" | empty (= anthropic when ANTHROPIC_API_KEY is set, else rules engine)
LLM_PROVIDER=""
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen3:8b"
OLLAMA_NUM_CTX="8192"
OLLAMA_THINK="false"
OLLAMA_KEEP_ALIVE="30m"

# Hosted open-weight models via any OpenAI-compatible API (for deployments).
# Groq:       OPENAI_BASE_URL="https://api.groq.com/openai/v1"   OPENAI_MODEL e.g. "qwen/qwen3-32b"
# OpenRouter: OPENAI_BASE_URL="https://openrouter.ai/api/v1"     OPENAI_MODEL e.g. "qwen/qwen3-32b"
# Set LLM_PROVIDER="openai" to use it. OPENAI_JSON_MODE="object" for models without json_schema support.
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_JSON_MODE=""

# Agent pacing for live demos (ms per phase; full builds are multiplied by BC_BUILD_PACING)
BC_AGENT_STEP_MS="2500"
BC_BUILD_PACING="5"
BC_TASK_TIMEOUT_MS="120000"
BC_LLM_TIMEOUT_MS="60000"
